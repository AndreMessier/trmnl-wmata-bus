<div class="layout layout--col">
  {% assign stops = trmnl.plugin_settings.custom_fields_values.stop_ids | split: "," %}
  {% if stops.size == 1 %}
    {% assign all = data.Predictions %}
  {% else %}
    {% for stop in stops %}
      {% assign idx_key = "IDX_" | append: forloop.index0 %}
      {% assign group = data[idx_key].Predictions %}
      {% if forloop.first %}
        {% assign all = group %}
      {% else %}
        {% assign all = all | concat: group %}
      {% endif %}
    {% endfor %}
  {% endif %}
  {% assign all = all | sort: "Minutes" %}
  <table class="table">
    <thead>
      <tr>
        <th style="padding-right:24px; text-align:left;"><span class="title">Route</span></th>
        <th style="padding-right:24px; text-align:left;"><span class="title">Direction</span></th>
        <th style="text-align:left;"><span class="title">Min</span></th>
      </tr>
    </thead>
    <tbody>
      {% if all.size == 0 %}
        <tr><td colspan="3"><span class="label label--gray-out">No predictions available</span></td></tr>
      {% else %}
        {% for p in all limit: 8 %}
        <tr>
          <td><span class="line">{{ p.RouteID }}</span></td>
          <td><span class="label">{{ p.DirectionText }}</span></td>
          {% if p.Minutes == 0 %}
          <td><span class="label label--inverted" style="width:fit-content;">ARR</span></td>
          {% else %}
          <td><span class="label">{{ p.Minutes }}</span></td>
          {% endif %}
        </tr>
        {% endfor %}
      {% endif %}
    </tbody>
  </table>
</div>
<div class="title_bar">
  <img class="image" src="https://upload.wikimedia.org/wikipedia/commons/0/0a/WMATA_Metro_Logo_small.svg" />
  <span class="title">{{ trmnl.plugin_settings.custom_fields_values.title_text | default: "WMATA Bus" }}</span>
  <span class="instance">Refreshed at {{ 'now' | date: '%H:%M' }}</span>
</div>
